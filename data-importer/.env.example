# Database Configuration
# Use either DATABASE_URL or individual DB_* variables

# Option 1: Connection string (recommended)
DATABASE_URL=postgresql://pricecomp_user:abc@localhost:5532/pricecomp_db

# Option 2: Individual connection parameters
# DB_HOST=localhost
# DB_PORT=5532
# DB_NAME=pricecomp_db
# DB_USER=pricecomp_user
# DB_PASSWORD=abc

# Optional Configuration
# LOG_LEVEL=info
# BATCH_SIZE=500
