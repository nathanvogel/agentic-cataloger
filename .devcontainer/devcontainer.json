{
  "name": "pricecomp",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "root",
      "uid": "0",
      "gid": "0"
    }
  },
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.dev.yml"
  ],
  "service": "api",
  "workspaceFolder": "/workspaces/pricecomp",
  "shutdownAction": "stopCompose",
  "runServices": [
    "postgres",
    "phoenix",
    "api"
  ],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  // Claude Code auth + user settings persist across rebuilds (Anthropic devcontainer pattern).
  // Sign in once inside the container; host ~/.claude is separate. Project settings live in repo .claude/.
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume"
  ],
  // Only forward ports the api container listens on. Postgres/Phoenix are sibling
  // compose services with their own host publishes (3021:5432, 3022:6006). If the
  // IDE auto-forwards those onto the api container (where nothing listens), Mac
  // clients get TCP-up then "server closed the connection unexpectedly".
  "appPort": [
    "3020:3020",
    "3023:3023"
  ],
  "forwardPorts": [
    3020,
    3023
  ],
  "portsAttributes": {
    "3020": {
      "label": "Python API (pricecomp api)"
    },
    "3021": {
      "label": "PostgreSQL 18.4",
      "onAutoForward": "ignore"
    },
    "3022": {
      "label": "Phoenix UI",
      "onAutoForward": "ignore"
    },
    "3023": {
      "label": "Frontend Vite"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "containerEnv": {
    "COMPOSE_PROFILES": "api",
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "DATABASE_URL": "postgresql://pricecomp_app:pricecomp_app_dev@postgres:5432/pricecomp_app",
    "RTK_TELEMETRY_DISABLED": "1"
  },
  "remoteEnv": {
    "PATH": "/root/.local/bin:/workspaces/pricecomp/backend/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "python.defaultInterpreterPath": "/workspaces/pricecomp/backend/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "anthropic.claude-code",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "github.vscode-pull-request-github"
      ]
    }
  }
}