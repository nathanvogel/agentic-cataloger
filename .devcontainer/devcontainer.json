{
  "name": "pricecomp",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.dev.yml"],
  "service": "api",
  "workspaceFolder": "/workspaces/pricecomp",
  "shutdownAction": "stopCompose",
  "runServices": ["postgres", "phoenix", "api"],
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  // Sync host Claude Code prefs/auth into the container (same account as on the Mac).
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/root/.claude.json,type=bind,consistency=cached"
  ],
  // Only map ports the api devcontainer listens on. Postgres (3021) and Phoenix
  // (3022) are sibling compose services — their host bindings come from
  // docker-compose.yml (3021:5432, 3022:6006). Mapping 3022→api:3022 caused
  // NS_ERROR_NET_EMPTY_RESPONSE because nothing listens there.
  "appPort": ["3020:3020", "3023:3023"],
  "forwardPorts": [3020, 3023],
  "portsAttributes": {
    "3020": { "label": "Python API (pricecomp api)" },
    "3023": { "label": "Frontend Vite" }
  },
  "otherPortsAttributes": {
    "3021": { "label": "PostgreSQL 18.4" },
    "3022": { "label": "Phoenix UI" }
  },
  "containerEnv": {
    "COMPOSE_PROFILES": "api",
    "CLAUDE_CONFIG_DIR": "/root/.claude",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
    "DATABASE_URL": "postgresql://pricecomp_app:pricecomp_app_dev@postgres:5432/pricecomp_app"
  },
  "remoteEnv": {
    "PATH": "/root/.local/bin:/workspaces/pricecomp/backend/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "python.defaultInterpreterPath": "/workspaces/pricecomp/backend/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "anthropic.claude-code",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "github.vscode-pull-request-github"
      ]
    }
  }
}
