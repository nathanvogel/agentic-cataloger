# Database Configuration
DATABASE_URL=postgresql://pricecomp_user:abc@localhost:5532/pricecomp_db

# LLM API Keys (at least one required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration (Optional - Override default models per operation)
# CATEGORY_DISCOVERY_PROVIDER=openai
# CATEGORY_DISCOVERY_MODEL=gpt-4o
# SCHEMA_GENERATION_PROVIDER=openai
# SCHEMA_GENERATION_MODEL=gpt-4o
# ATTRIBUTE_EXTRACTION_PROVIDER=anthropic
# ATTRIBUTE_EXTRACTION_MODEL=claude-3-5-sonnet-20241022

# Optional Configuration
LOG_LEVEL=info
