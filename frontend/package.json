{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "preview-build": "firebase emulators:start --only hosting",
    "dev": "react-router dev",
    "dev-ssl": "USE_DEV_SSL=true react-router dev",
    "typecheck": "react-router typegen && tsc",
    "lint": "echo 'checking eslint' && eslint app --max-warnings 0 --fix && echo 'eslint complete\nchecking tsc' && tsc --noEmit && echo 'tsc complete'",
    "format": "prettier --write \"app/**/*.{ts,tsx,yml}\" \"*.{js,json,yml}\"",
    "prettier:check": "prettier --check \"app/**/*.{ts,tsx,yml}\" \"*.{js,json,yml}\"",
    "lint-staged": "lint-staged",
    "prepare": "cd .. && husky",
    "schema:generate": "openapi-typescript ../docs/specs/backend-api.yaml -o ./app/schema/backend-schema.d.ts"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.tsx": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.2.0",
    "@mui/material": "7.2.0",
    "@mui/styled-engine-sc": "7.1.0",
    "@mui/system": "7.1.1",
    "@mui/x-charts": "8.5.0",
    "@radix-ui/themes": "3.2.1",
    "@react-router/node": "7.6.3",
    "@react-router/serve": "7.6.3",
    "@tanstack/react-query": "5.75.4",
    "immer": "10.1.1",
    "isbot": "^5",
    "openapi-fetch": "0.14.0",
    "openapi-react-query": "0.5.0",
    "openapi-typescript": "7.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "7.6.3",
    "react-router-dom": "7.6.3",
    "styled-components": "6.1.18",
    "vike": "0.4.229",
    "zustand": "5.0.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.26.0",
    "@react-router/dev": "7.6.3",
    "@tailwindcss/vite": "4.1.4",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/node": "20",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@typescript-eslint/eslint-plugin": "8.32.0",
    "@typescript-eslint/parser": "8.32.0",
    "@vitejs/plugin-basic-ssl": "2.1.0",
    "eslint": "9.26.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-i18next": "6.1.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "firebase-tools": "14.9.0",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.0",
    "vite": "6.3.3",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-devtools-json": "0.2.1",
    "vite-tsconfig-paths": "5.1.4"
  },
  "packageManager": "yarn@4.11.0"
}
