{
  "js/ts.tsdk.path": "frontend/node_modules/typescript/lib",
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.venvPath": "${workspaceFolder}/backend",
  "python.terminal.activateEnvironment": false,
  "ruff.configuration": "${workspaceFolder}/backend/pyproject.toml",
  "ruff.interpreter": [
    "${workspaceFolder}/backend/.venv/bin/python"
  ],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "cursorpyright.analysis.typeCheckingMode": "basic",
  "cursorpyright.analysis.extraPaths": [
    "backend/src"
  ],
  "cursorpyright.analysis.diagnosticMode": "workspace",
  "cSpell.words": [
    "asiatisch",
    "asyncio",
    "bananen",
    "bmad",
    "checkpointer",
    "contextlib",
    "CREATEDB",
    "datname",
    "delenv",
    "Denner",
    "Docstrings",
    "esac",
    "evals",
    "fairtrade",
    "fastapi",
    "fastmcp",
    "fdfind",
    "gerichte",
    "httpx",
    "isort",
    "isready",
    "langchain",
    "langgraph",
    "libatomic",
    "libpq",
    "litschi",
    "litschis",
    "Litschis",
    "Magento",
    "mccabe",
    "Milchprodukte",
    "nathanvogel",
    "naturaplan",
    "Obst",
    "offenverkauf",
    "Offenverkauf",
    "openinference",
    "Perflint",
    "PGHOST",
    "PGPORT",
    "PGQUEUER",
    "poolclass",
    "pprint",
    "prefs",
    "pricecomp",
    "psql",
    "psycopg",
    "pycache",
    "pycodestyle",
    "Pydantic",
    "pydoclint",
    "pydocstyle",
    "Pyflakes",
    "Pylint",
    "pyproject",
    "Pytest",
    "PYTHONDONTWRITEBYTECODE",
    "PYTHONUNBUFFERED",
    "pyyaml",
